<script>
// Bind clean scenario controls and generate prose directly from all five choices.
const finalInputs=['heritage','access','sustain','tech','community'].map(id=>document.getElementById(id)).filter(Boolean).map(input=>{const clone=input.cloneNode(true);input.replaceWith(clone);return clone});function scenarioNarrative(){const v=Object.fromEntries(finalInputs.map(i=>[i.id,+i.value]));const level=n=>n>=70?'strong':n>=40?'growing':'early';const title=v.community>=70&&v.heritage>=60?'A community-shaped cultural renaissance':v.access>=70?'Culture within everyone’s reach':v.tech>=70?'New tools, grounded in culture':v.sustain>=70?'A more sustainable creative economy':'A future still being negotiated';const text=`In this version of India 2047, heritage support is ${level(v.heritage)}, public access is ${level(v.access)}, sustainable making is ${level(v.sustain)}, creative technology is ${level(v.tech)}, and community leadership is ${level(v.community)}. That mix could shape who creates, who participates, and how cultural knowledge is carried forward.`;document.querySelector('#scenario-title').textContent=title;document.querySelector('#scenario-copy').textContent=text}finalInputs.forEach(input=>input.addEventListener('input',scenarioNarrative));scenarioNarrative();
