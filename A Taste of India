document.querySelector('.slider-label.left').textContent='Then · Ajanta mural';document.querySelector('.slider-label.right').textContent='Now · contemporary Indian art';document.querySelector('.slider-caption span:first-child').textContent='Ajanta’s Buddhist narrative mural tradition';document.querySelector('.slider-caption span:last-child').textContent='Vijay Singh Mohite · abstract painting, 1972';
// Grow the scenario builder into a visibly responsive creative-future dashboard.
const scenarioControls=document.querySelector('.controls');scenarioControls.insertAdjacentHTML('beforeend',`<div class="control"><label for="tech">Creative technology <output id="tech-out">60</output></label><input id="tech" type="range" min="0" max="100" value="60"></div><div class="control"><label for="community">Community leadership <output id="community-out">70</output></label><input id="community" type="range" min="0" max="100" value="70"></div>`);const resultBox=document.querySelector('.scenario-result');resultBox.insertAdjacentHTML('beforeend','<div class="scenario-meter" aria-label="Future balance"><span id="scenario-meter-fill"></span></div><div class="scenario-tags" id="scenario-tags"></div><small id="scenario-balance"></small>');function renderFutureScenario(){const ids=['heritage','access','sustain','tech','community'],v=ids.map(id=>+document.getElementById(id).value),[heritage,access,sustain,tech,community]=v;ids.forEach((id,i)=>{document.getElementById(id+'-out').value=v[i]});const avg=Math.round(v.reduce((a,b)=>a+b,0)/v.length);const title=community>76&&heritage>70?'Community-held culture, shared widely':tech>76&&access>68?'Creative tools for many hands':sustain>76?'A circular culture of making':access<35?'A future with an access gap':heritage<35?'A bold but root-light experiment':'A plural future in motion';const copy=`With these choices, your imagined India 2047 gives ${heritage>65?'strong space':'more room to build'} to living heritage, makes culture ${access>65?'widely accessible':'a priority to widen'}, and treats sustainable making as ${sustain>65?'a guiding value':'work still to do'}. Creative technology is ${tech>65?'a strong creative force':'used selectively'}, while community leadership is ${community>65?'central to decisions':'an area to strengthen'}.`;document.querySelector('#scenario-title').textContent=title;document.querySelector('#scenario-copy').textContent=copy;document.querySelector('#scenario-meter-fill').style.width=avg+'%';document.querySelector('#scenario-balance').textContent=`Future balance: ${avg}/100 · five choices combine in this scenario.`;document.querySelector('#scenario-tags').innerHTML=[['Heritage',heritage],['Access',access],['Sustainability',sustain],['Technology',tech],['Community',community]].map(([n,x])=>`<span>${n} ${x}</span>`).join('');resultBox.style.background=`radial-gradient(circle at ${tech}% ${100-community/2}%,rgba(83,119,219,${.14+tech/500}),transparent 55%),#222747`;resultBox.style.boxShadow=`inset 4px 0 0 rgba(198,157,86,${.25+heritage/140})`}['heritage','access','sustain','tech','community'].forEach(id=>document.getElementById(id).addEventListener('input',renderFutureScenario));renderFutureScenario();
// Add quick curiosity and a small culture-pairs memory game.
const tabs=document.querySelector('.explore-tabs');const factsTab=document.createElement('button');factsTab.className='explore-tab';factsTab.setAttribute('role','tab');factsTab.setAttribute('aria-selected','false');factsTab.dataset.panel='facts';factsTab.textContent='Fun facts';tabs.append(factsTab);const gameTab=document.createElement('button');gameTab.className='explore-tab';gameTab.setAttribute('role','tab');gameTab.setAttribute('aria-selected','false');gameTab.dataset.panel='game';gameTab.textContent='Memory game';tabs.append(gameTab);const quizPanel=document.querySelector('#panel-quiz');quizPanel.insertAdjacentHTML('afterend',`<div class="panel" id="panel-facts"><div class="new-explore-panel"><span class="eyebrow">Small details, big stories</span><div class="fact-card" aria-live="polite"><h3 id="fact-title">A curious cultural fact</h3><p id="fact-copy"></p></div><button class="btn" id="another-fact" type="button">Reveal another fact ↗</button><div class="fact-card" style="margin-top:32px"><span class="eyebrow">Think & tell</span><h3 id="think-title">A question for your audience</h3><p id="think-copy"></p><button id="another-think" type="button" style="margin-top:14px;border:1px solid #ad563d;background:transparent;color:#ad563d;padding:9px 12px;cursor:pointer">Another prompt</button></div></div></div><div class="panel" id="panel-game"><div class="new-explore-panel"><span class="eyebrow">A little memory challenge</span><h3 style="font:500 1.7rem var(--serif);margin:8px 0">Pair the art with its home.</h3><p style="color:#777268">Match each cultural form to its clue. Find all four pairs in as few turns as you can.</p><div class="game-head"><strong id="game-status" aria-live="polite">Four pairs · 0 turns</strong><button type="button" id="game-reset">Shuffle & restart</button></div><div id="game-board" class="game-board" role="group" aria-label="Cultural memory matching game"></div></div></div>`);function activateExploreTab(btn){document.querySelectorAll('.explore-tab').forEach(t=>t.setAttribute('aria-selected','false'));document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));btn.setAttribute('aria-selected','true');document.querySelector('#panel-'+btn.dataset.panel).classList.add('active')}document.querySelectorAll('.explore-tab').forEach(b=>b.addEventListener('click',()=>activateExploreTab(b)));const facts=[['The tiny art of a giant story','Cheriyal scroll paintings from Telangana use vivid figures to narrate stories, traditionally shown by travelling storytellers.'],['A metal with a deep black finish','Bidriware from Bidar is an alloy craft whose dark surface contrasts with fine silver inlay.'],['Dances with three distinct lineages','Chhau includes the Purulia, Seraikella and Mayurbhanj styles, each with its own movement and mask traditions.'],['The oldest living Sanskrit theatre?','Koodiyattam, performed in Kerala, is a Sanskrit theatre tradition recognized by UNESCO as an Intangible Cultural Heritage.'],['A sari woven in one piece','Some Patola saris of Patan use double ikat, where both warp and weft threads are resist-dyed before weaving.'],['A painting made on cloth','Pattachitra artists in Odisha prepare cloth surfaces and build finely detailed compositions with natural motifs.'],['India’s national academies','The Sangeet Natak Akademi was established in 1953; the Sahitya Akademi and Lalit Kala Akademi followed in 1954.']];let factIndex=-1;function showFact(){factIndex=(factIndex+1)%facts.length;document.querySelector('#fact-title').textContent=facts[factIndex][0];document.querySelector('#fact-copy').textContent=facts[factIndex][1]}showFact();document.querySelector('#another-fact').addEventListener('click',showFact);const prompts=['Which cultural practice in your family or neighbourhood deserves to be documented—and who should tell its story?','Can a digital archive preserve a tradition if the people who practise it cannot control how it is used?','What might a future-facing Indian artwork keep from the past, and what might it change?','How can a craft become more sustainable without making life harder for the craftsperson?','Which language, song or art form would you want a student in 2047 to be able to encounter?'];let promptIndex=-1;function showPrompt(){promptIndex=(promptIndex+1)%prompts.length;document.querySelector('#think-copy').textContent=prompts[promptIndex]}showPrompt();document.querySelector('#another-think').addEventListener('click',showPrompt);
const pairs=[['Pattachitra','Odisha cloth painting'],['Bidriware','Bidar inlaid metalwork'],['Koodiyattam','Kerala Sanskrit theatre'],['Chhau','Eastern Indian dance']];let gameDeck=[],selectedTiles=[],matches=0,turns=0,lockGame=false;function startGame(){gameDeck=pairs.flatMap((pair,index)=>pair.map((label,side)=>({label,pair:index,key:index+'-'+side}))).sort(()=>Math.random()-.5);selectedTiles=[];matches=0;turns=0;lockGame=false;document.querySelector('#game-status').textContent='Four pairs · 0 turns';document.querySelector('#game-board').innerHTML=gameDeck.map((card,i)=>`<button class="game-tile" type="button" data-card="${i}" aria-pressed="false" aria-label="Hidden culture card">?</button>`).join('');document.querySelectorAll('.game-tile').forEach(btn=>btn.addEventListener('click',()=>flipCard(btn)))}function flipCard(btn){if(lockGame||btn.classList.contains('matched')||btn.getAttribute('aria-pressed')==='true')return;const card=gameDeck[+btn.dataset.card];btn.textContent=card.label;btn.setAttribute('aria-label',card.label);btn.setAttribute('aria-pressed','true');selectedTiles.push({btn,card});if(selectedTiles.length===2){turns++;const [a,b]=selectedTiles;if(a.card.pair===b.card.pair){a.btn.classList.add('matched');b.btn.classList.add('matched');a.btn.setAttribute('aria-label','Matched: '+a.card.label);b.btn.setAttribute('aria-label','Matched: '+b.card.label);matches++;selectedTiles=[];document.querySelector('#game-status').textContent=matches===4?`All pairs found in ${turns} turns. Brilliant!`:`${4-matches} pairs left · ${turns} turns`}else{lockGame=true;document.querySelector('#game-status').textContent=`Not a pair · ${turns} turns`;setTimeout(()=>{selectedTiles.forEach(x=>{x.btn.textContent='?';x.btn.setAttribute('aria-label','Hidden culture card');x.btn.setAttribute('aria-pressed','false')});selectedTiles=[];lockGame=false},900)}}}document.querySelector('#game-reset').addEventListener('click',startGame);startGame();
// A niche, three-choice quiz; each question has one keyed answer and an explicit score.
const hardQuestions=[['Which region is most closely associated with Cheriyal scroll painting?',['Telangana','Assam','Goa'],0],['Bidriware is traditionally made from which base alloy?',['Brass and tin','Zinc and copper','Iron and silver'],1],['Which Chhau style is especially known for elaborate masks?',['Purulia','Mayurbhanj','Seraikella'],0],['Which dance-drama tradition is performed in Kerala temples in Sanskrit?',['Yakshagana','Koodiyattam','Bhavai'],1],['Patan Patola is created using which complex weaving approach?',['Double ikat','Jamdani supplementary weft','Kalamkari resist painting'],0],['Which is the correct distinction for Mayurbhanj Chhau?',['It is traditionally maskless','It uses only hand puppets','It is performed seated'],0],['The Natyashastra is traditionally attributed to whom?',['Bharata Muni','Kalidasa','Abhinavagupta'],0],['A pichvai painting is most closely associated with which devotional setting?',['Srinathji at Nathdwara','Jagannath at Puri','Vithoba at Pandharpur'],0],['Which Indian textile technique uses a resist-dyed warp and weft before weaving?',['Ikat','Phulkari','Chikankari'],0],['The Raga Malkauns traditionally uses how many notes in its ascent and descent?',['Five','Six','Seven'],0],['Which 1954 institution is dedicated to the visual arts?',['Lalit Kala Akademi','Sahitya Akademi','Sangeet Natak Akademi'],0],['Which is a traditional scroll-painting lineage from Rajasthan?',['Phad','Ganjifa','Kavad'],0],['The stringed instrument rudra veena is especially associated with which vocal tradition?',['Dhrupad','Thumri','Tappa'],0],['Which material is central to the traditional blue-and-white art of Bidri inlay?',['Silver wire','Glass beads','Lacquered bamboo'],0]];let questionOrder=[],questionCursor=0,quizScore=0,answered=false;const quizBox=document.querySelector('#panel-quiz .quiz');quizBox.innerHTML=`<div class="quiz-content"><span class="eyebrow">Specialist round</span><h3 id="quiz-question"></h3><p id="quiz-hint">Choose one answer. One correct answer per question.</p><div class="quiz-options" id="quiz-options"></div></div><div class="quiz-side"><strong id="quiz-progress">Question 1 of ${hardQuestions.length}</strong><p id="quiz-score" style="color:#777268;font-size:.8rem">Score: 0</p></div><div class="quiz-feedback" id="quiz-feedback" aria-live="polite"></div>`;function loadQuestion(){if(questionCursor>=questionOrder.length){questionOrder=Array.from(hardQuestions.keys()).sort(()=>Math.random()-.5);questionCursor=0;quizScore=0}answered=false;const q=hardQuestions[questionOrder[questionCursor]];document.querySelector('#quiz-question').textContent=q[0];document.querySelector('#quiz-progress').textContent=`Question ${questionCursor+1} of ${hardQuestions.length}`;document.querySelector('#quiz-score').textContent=`Score: ${quizScore}`;document.querySelector('#quiz-feedback').textContent='';document.querySelector('#quiz-options').innerHTML=q[1].map((option,i)=>`<button type="button" data-answer="${i}">${option}</button>`).join('');document.querySelectorAll('#quiz-options button').forEach(btn=>btn.addEventListener('click',()=>answerQuestion(+btn.dataset.answer,q)))}function answerQuestion(choice,q){if(answered)return;answered=true;document.querySelectorAll('#quiz-options button').forEach((b,i)=>{b.disabled=true;if(i===q[2])b.style.borderColor='#66845a'});if(choice===q[2]){quizScore++;document.querySelector('#quiz-feedback').textContent='Correct. '+q[1][q[2]]+' is the right answer.'}else document.querySelector('#quiz-feedback').textContent=`Not quite. The answer is ${q[1][q[2]]}.`;document.querySelector('#quiz-score').textContent=`Score: ${quizScore}`;const next=document.createElement('button');next.type='button';next.className='quiz-next';next.textContent=questionCursor===questionOrder.length-1?'Start a new round':'Next question →';next.addEventListener('click',()=>{questionCursor++;loadQuestion()});document.querySelector('#quiz-options').append(next)}questionOrder=Array.from(hardQuestions.keys()).sort(()=>Math.random()-.5);loadQuestion();
</script>
<script>
// Presentation repair pass: essay-style timeline, reliable controls, and accurate source visuals.
const threePartTimeline={roots:['Many histories, no single origin',['For centuries, the subcontinent has been shaped by many communities, languages, belief systems and exchanges. Its cultural story is a weave of regional histories, not one uniform tradition.','Artists and craftspeople made images on rock, paper, cloth, walls and metal; performers carried stories through music, dance and theatre; writers developed rich traditions across Indian languages.','Trade, pilgrimage, migration and changing forms of patronage carried techniques and ideas across regions. Each generation adapted what it inherited, so continuity and change have always lived side by side.']],independence:['Freedom and rupture',['India became independent on 15 August 1947 after a long anticolonial movement. The new republic began the work of imagining shared civic life among people with many languages, faiths and regional identities.','Partition accompanied independence with mass displacement and violence. Families lost homes and communities; writers, artists and filmmakers later returned to these difficult memories through stories of migration, grief and belonging.','The cultural life of the new nation included celebration, argument and experimentation. Artists asked how a modern India could be represented—and whose experiences had been left out.']],post:['Building new cultural publics',['After independence, national academies, museums, universities and public broadcasters created new platforms for artists, writers and performers. Regional institutions and local initiatives also sustained cultural life.','Painters explored abstraction and new forms of representation; theatre-makers and novelists engaged with social change; filmmakers brought stories about work, family and public life to expanding audiences.','Radio, print, cinema and later television changed how culture travelled. These developments did not produce one national style: artists continued to negotiate language, region, identity, access and patronage.']],today:['Tradition in active conversation',['A dancer may learn within a long guru–shishya lineage and share a rehearsal with a global audience online. A handloom pattern may carry local knowledge while appearing in contemporary design.','Streaming and social platforms give more people ways to encounter independent films, music and art in many languages, while questions of credit, fair pay and visibility remain.','Digital archives can preserve recordings, photographs and texts. Good preservation also asks who has the right to describe, share and make decisions about cultural knowledge.']],future:['A future people can shape',['India’s centenary in 2047 is a chance to imagine what cultural life could become. Possible futures depend on choices about public support, education, technology, livelihoods and community leadership.','Artists may use AI, augmented reality or virtual spaces to experiment and reach new audiences. Those tools will raise questions about authorship, consent, access and the value of human skill.','Living languages, local materials, repair practices and fair opportunities for artists could all shape a more sustainable future. These are possibilities—not predictions or guaranteed outcomes.']]};document.querySelectorAll('.time-item').forEach(button=>button.addEventListener('click',()=>{const entry=threePartTimeline[button.dataset.period];if(!entry)return;document.querySelectorAll('.time-item').forEach(b=>b.setAttribute('aria-selected','false'));button.setAttribute('aria-selected','true');document.querySelector('#timeline-title').textContent=entry[0];document.querySelector('#timeline-copy').innerHTML=entry[1].map(p=>`<p>${p}</p>`).join('')}));
// Add the national cultural-policy outlook to the 1947 chapter as a clearly dated plan.
document.querySelector('.ind-copy').insertAdjacentHTML('beforeend',`<aside class="future-disclaimer" style="margin-top:28px"><strong>Looking ahead · Ministry of Culture, 2025</strong><p style="margin:8px 0 12px">The Ministry has described a Viksit Bharat 2047 cultural vision centred on preserving heritage, widening participation, using technology in arts and preservation, growing the creative economy, and building global cultural partnerships. It also describes digital repositories and more engaging heritage-site visits as areas of work. These are stated priorities; their eventual impact will depend on implementation.</p><a href="https://www.pib.gov.in/PressReleasePage.aspx?PRID=2118258&lang=2&reg=48" target="_blank" rel="noopener">Read the Ministry’s 2025 statement ↗</a></aside>`);
// Give each 2047 possibility concrete context, then distinguish it from announced policy.
const futureDetails=[['AI as a creative partner','An artist could use a generative tool to test colour, rhythm or composition, then make the final decisions. Clear credit, consent and fair treatment of source material would matter. This is a possibility, not a promised outcome.'],['Culture in AR & VR','An immersive experience could let a class explore a distant monument or performance setting. It should add context and access while respecting the communities connected to that place.'],['Living digital archives','More recordings, oral histories and craft knowledge could be preserved in searchable digital collections. Community-led consent, language access and long-term stewardship would be essential.'],['Global Indian culture','Artists in India and across the diaspora could collaborate across languages and media. New hybrids may emerge while local histories and distinct voices remain visible.'],['Sustainable traditions','Repair, reuse, natural dyes and locally sourced materials could inform lower-impact creative practice. Supporting artisan livelihoods would be as important as celebrating the finished object.'],['More people making','Affordable tools and strong arts education could help more young people create and share work. Public access, disability inclusion and regional-language resources would shape who benefits.']];document.querySelectorAll('.future-card p').forEach((p,i)=>{if(futureDetails[i])p.textContent=futureDetails[i][1]});document.querySelector('.future-grid').insertAdjacentHTML('afterend',`<aside class="future-disclaimer" style="margin-top:22px"><strong>What government has said it intends:</strong> the Ministry of Culture’s 2025 Viksit Bharat 2047 vision names heritage preservation, wider participation, technology, creative-economy growth and global cultural partnerships. It also discusses digital repositories and technology-enabled preservation. These are stated policy aims; the cards above are possible outcomes, not facts about 2047. <a href="https://www.pib.gov.in/PressReleasePage.aspx?PRID=2118258&lang=2&reg=48" target="_blank" rel="noopener">Official source ↗</a></aside>`);
// Replace the hand-drawn map with a current state-and-UT boundary map; keep cultural regions selectable.
const mapLayout=document.querySelector('.map-layout'),mapReadout=document.querySelector('.map-readout'),realMap=document.createElement('img');realMap.className='india-map';realMap.src='https://upload.wikimedia.org/wikipedia/commons/6/69/India_states_and_union_territories_map.svg';realMap.alt='Map of India showing state and union territory boundaries and capitals';realMap.loading='lazy';realMap.referrerPolicy='no-referrer';mapLayout.replaceChild(realMap,mapLayout.querySelector('.india-map'));const regions=[['North',['Kathak storytelling and rhythmic footwork','Kashmiri papier-mâché and carpet making','Hindustani vocal lineages including dhrupad and khayal']],['West',['Patan Patola double-ikat weaving in Gujarat','Rajasthan’s Phad painted narrative scrolls','Warli painting and Ajanta’s Buddhist murals in Maharashtra']],['Central',['Bhimbetka’s prehistoric rock shelters','Gond painting and other Adivasi visual traditions','Regional music, dance and craft lineages']],['East',['Odisha’s Pattachitra painting and Odissi dance','Purulia, Seraikella and Mayurbhanj Chhau traditions','Bengal’s Baul songs and patachitra scrolls']],['North East',['Assam’s Sattriya performance tradition','Assamese muga silk weaving','Distinct languages, textiles, masks and music across eight states']],['South',['Kerala’s Koodiyattam Sanskrit theatre','Tamil Nadu’s bronze casting and Bharatanatyam lineages','Carnatic music and Karnataka’s Mysore painting']],['Islands',['Andaman and Nicobar Islands’ distinct Indigenous histories','Lakshadweep’s Indian Ocean connections','Island ecologies shape craft, architecture and foodways']]];mapReadout.insertAdjacentHTML('afterbegin','<div class="map-regions" role="group" aria-label="Choose a cultural region"></div>');const mapButtons=mapReadout.querySelector('.map-regions');regions.forEach(([name])=>mapButtons.insertAdjacentHTML('beforeend',`<button type="button" data-area="${name}">${name}</button>`));mapReadout.insertAdjacentHTML('beforeend','<p class="map-credit">State and union territory outlines: <a href="https://commons.wikimedia.org/wiki/File:India_states_and_union_territories_map.svg" target="_blank" rel="noopener">Wikimedia Commons map</a> · <a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener">CC BY-SA 3.0 license</a>. Cultural regions below are broad learning groupings, not political boundaries.</p>');function showRegion(name){const region=regions.find(r=>r[0]===name);if(!region)return;mapReadout.querySelector('#region-title').textContent=region[0];mapReadout.querySelector('#region-copy').textContent='A few cultural entry points from a region with many more communities, languages and histories:';let list=mapReadout.querySelector('#region-facts');if(!list){list=document.createElement('ul');list.id='region-facts';list.className='map-facts';mapReadout.append(list)}list.innerHTML=region[1].map(f=>`<li>${f}</li>`).join('');mapButtons.querySelectorAll('button').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.area===name)))}mapButtons.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>showRegion(b.dataset.area)));showRegion('North');
// Rebind the contemporary-culture selector so every lens changes its text, photograph and alt text.
const cultureViews={digital:['Digital art','Art goes online.','Artists share work directly, remix visual languages and build new audiences. Digital tools widen access while raising questions about credit, ownership and who gets seen.','https://images.unsplash.com/photo-1513364776144-60967b0f800f?auto=format&fit=crop&w=1200&q=85','Artist working on a contemporary painting'],music:['Fusion music','Many ways to listen.','Musicians bring ragas, folk instruments and regional sounds into conversation with electronic production, hip-hop and global genres. A fusion can be playful, but it also depends on listening closely to each tradition.','https://i1.sndcdn.com/artworks-2lfByF8IpjxE5yUW-LebjUQ-t500x500.jpg','Sitar and tabla artist performing live'],fashion:['Contemporary fashion','Cloth carries memory.','Designers reinterpret handloom, embroidery and regional silhouettes in contemporary clothing. The story includes technique and beauty, as well as artisan pay, material sourcing and who receives credit.','https://cdn.thevoiceoffashion.com/bodyblocks/64d0d89b1dba4.jpg','Indian handloom artisan weaving patterned cloth'],cinema:['Cinema','Stories travel further.','Independent films and streaming bring more languages and stories to viewers. Filmmakers use music, editing and visual style to explore memory, identity and modern life.','https://images.indianexpress.com/2022/07/Film-Working-Team-759.jpg','Film crew working with a camera on a set']};function renderCulture(key){const data=cultureViews[key];if(!data)return;document.querySelector('#today-kicker').textContent=data[0];document.querySelector('#today-title').textContent=data[1];document.querySelector('#today-copy').textContent=data[2];const image=document.querySelector('.today-image');image.style.backgroundImage=`linear-gradient(90deg,rgba(13,18,35,.08),rgba(13,18,35,.08)),url("${data[3]}")`;image.setAttribute('aria-label',data[4]);image.dataset.credit=data[0]}document.querySelectorAll('.mode-btn').forEach(old=>{const button=old.cloneNode(true);old.replaceWith(button);button.addEventListener('click',()=>{document.querySelectorAll('.mode-btn').forEach(b=>b.setAttribute('aria-pressed','false'));button.setAttribute('aria-pressed','true');renderCulture(button.dataset.mode)})});renderCulture('digital');
// Make the before/after reveal track the range control exactly and remain keyboard-operable.
const oldRange=document.querySelector('#compare-range'),range=oldRange.cloneNode(true);oldRange.replaceWith(range);const reveal=document.querySelector('#slider-after');function moveReveal(){const value=Number(range.value);reveal.style.clipPath=`inset(0 0 0 ${value}%)`;range.setAttribute('aria-valuetext',`${100-value}% then, ${value}% now`)}range.addEventListener('input',moveReveal);moveReveal();document.querySelector('.slider-label.left').textContent='Then · Ajanta mural';document.querySelector('.slider-label.right').textContent='Now · contemporary Indian art';document.querySelector('.slider-caption span:first-child').textContent='Ajanta Buddhist narrative mural tradition';document.querySelector('.slider-caption span:last-child').textContent='Vijay Singh Mohite · abstract painting, 1972';
// The scenario controls write a changing short paragraph. No score, percentage meter or numeric rating.
document.querySelectorAll('.scenario-meter,.scenario-tags,#scenario-balance').forEach(el=>el.remove());const scenarioInputs=['heritage','access','sustain','tech','community'].map(id=>document.getElementById(id)).filter(Boolean);function narrateScenario(){const v=Object.fromEntries(scenarioInputs.map(i=>[i.id,+i.value]));const strongest=Object.entries(v).sort((a,b)=>b[1]-a[1])[0][0];const stories={heritage:['A future rooted in living heritage','Your choices put artists, craft knowledge, languages and cultural practice at the centre. New work grows from traditions that remain active in communities.'],access:['Culture within reach','Your choices imagine libraries, museums, performances and creative tools reaching more people—in more regions, languages and accessible formats.'],sustain:['A lighter way to make','Your choices favour repair, local materials and longer-lasting creative practices, while making fair livelihoods part of sustainability.'],tech:['New tools, human choices','Your choices put emerging creative technologies to work in art and heritage. Human authorship, consent and community context shape how those tools are used.'],community:['Communities shape the future','Your choices give local artists and knowledge-holders a strong voice in decisions about archives, cultural spaces and the use of their traditions.']};const [title,copy]=stories[strongest];document.querySelector('#scenario-title').textContent=title;document.querySelector('#scenario-copy').textContent=copy;document.querySelector('.scenario-result').style.background=`radial-gradient(circle at ${v.tech}% ${100-v.community/2}%,rgba(83,119,219,.18),transparent 55%),#222747`;scenarioInputs.forEach(i=>{const output=document.getElementById(i.id+'-out');if(output)output.remove()})}scenarioInputs.forEach(i=>i.addEventListener('input',narrateScenario));narrateScenario();
// Restart the quiz as a difficult three-choice challenge without scorekeeping.
const noScoreQuiz=document.querySelector('#panel-quiz .quiz');const difficultQuiz=[['Which textile combines resist-dyed warp and weft before weaving?',['Patola ikat','Kashida embroidery','Kullu twill'],0],['Bidriware’s dark ground is traditionally made from which alloy?',['Zinc and copper','Copper and tin','Silver and lead'],0],['Which Chhau form is traditionally performed without masks?',['Mayurbhanj','Purulia','Seraikella'],0],['Koodiyattam is a Sanskrit theatre tradition of which state?',['Kerala','Odisha','Assam'],0],['Which painting tradition from Rajasthan uses long narrative cloth scrolls?',['Phad','Pichvai','Kalamkari'],0],['Which devotional setting is most closely connected with Nathdwara pichvais?',['Shrinathji','Jagannath','Vithoba'],0],['Which instrument is closely associated with dhrupad performance?',['Rudra veena','Santoor','Shehnai'],0],['Cheriyal scroll painting is associated with which present-day state?',['Telangana','Bihar','Gujarat'],0],['Which dance tradition developed in Vaishnava monasteries called satras?',['Sattriya','Mohiniyattam','Kathakali'],0],['Which ancient site is especially renowned for Buddhist murals?',['Ajanta','Hampi','Sanchi'],0],['Which academy established in 1954 focuses on visual arts?',['Lalit Kala Akademi','Sahitya Akademi','Sangeet Natak Akademi'],0],['The Raga Malkauns is conventionally described as using how many swaras?',['Five','Six','Seven'],0]];let quizDeck=[],quizAt=0;function loadNoScoreQuestion(){if(quizAt>=quizDeck.length){quizDeck=difficultQuiz.map((_,i)=>i).sort(()=>Math.random()-.5);quizAt=0}const [question,options,correct]=difficultQuiz[quizDeck[quizAt]];noScoreQuiz.innerHTML=`<div class="quiz-content"><span class="eyebrow">Cultural quiz · specialist round</span><h3 id="quiz-question">${question}</h3><p id="quiz-hint">Choose one answer. There are three options.</p><div class="quiz-options">${options.map((option,i)=>`<button type="button" data-choice="${i}">${option}</button>`).join('')}</div></div><div class="quiz-feedback" aria-live="polite"></div>`;noScoreQuiz.querySelectorAll('[data-choice]').forEach(button=>button.addEventListener('click',()=>{noScoreQuiz.querySelectorAll('[data-choice]').forEach(b=>b.disabled=true);const feedback=noScoreQuiz.querySelector('.quiz-feedback');feedback.textContent=Number(button.dataset.choice)===correct?'Correct!':'Not quite. The answer is '+options[correct]+'.';const next=document.createElement('button');next.type='button';next.className='quiz-next';next.textContent='Next question →';next.addEventListener('click',()=>{quizAt++;loadNoScoreQuestion()});noScoreQuiz.querySelector('.quiz-options').append(next)}))}quizDeck=difficultQuiz.map((_,i)=>i).sort(()=>Math.random()-.5);loadNoScoreQuestion();
