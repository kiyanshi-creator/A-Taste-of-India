document.querySelector('.hero-kicker').textContent='A CULTURAL JOURNEY · 1947 → 2047';const heroCta=document.querySelector('.hero-content .btn');heroCta.textContent='BEGIN THE JOURNEY';heroCta.setAttribute('aria-label','Begin the cultural journey through India');heroCta.insertAdjacentHTML('afterend','<div class="journey-steps" aria-label="Roots to 2047">ROOTS <span>→</span> 1947 <span>→</span> TODAY <span>→</span> 2047</div>');
