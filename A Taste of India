cument.querySelector('#today-tags').innerHTML=d[3].map(t=>'<span class="tag">'+t+'</span>').join('');let image=document.querySelector('.today-image');image.style.backgroundImage=`linear-gradient(90deg,rgba(13,18,35,.05),rgba(13,18,35,.05)),url('${d[4]}')`;image.setAttribute('aria-label',d[5])}));
