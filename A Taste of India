const closing=document.querySelector('.closing');closing.querySelector('.eyebrow').textContent='WHAT WILL WE CREATE?';closing.querySelector('h2').innerHTML='The future of Indian culture isn’t something we inherit. <em>It’s something we create.</em>';closing.insertAdjacentHTML('beforeend','<p class="future-contribution" id="future-contribution" aria-live="polite">Your choices help shape what comes next.</p>');
