const mapSvg=document.querySelector('.india-map');mapSvg.setAttribute('viewBox','0 0 360 380');mapSvg.setAttribute('aria-label','Interactive outline map of India with cultural regions');mapSvg.innerHTML=`<defs><clipPath id="indiaClip"><path d="M93 22 116 12 145 20 159 35 179 37 195 52 210 68 227 76 244 84 263 82 282 89 297 99 291 108 270 110 250 103 235 111 227 126 213 140 219 154 215 171 210 188 210 207 202 226 194 246 185 267 178 288 165 312 151 333 141 320 134 299 127 279 121 258 113 238 108 216 98 198 87 183 76 169 69 153 75 139 65 126 58 108 64 94 54 80 61 66 78 55 89 39Z"/></clipPath></defs><path class="map-outline" d="M93 22 116 12 145 20 159 35 179 37 195 52 210 68 227 76 244 84 263 82 282 89 297 99 291 108 270 110 250 103 235 111 227 126 213 140 219 154 215 171 210 188 210 207 202 226 194 246 185 267 178 288 165 312 151 333 141 320 134 299 127 279 121 258 113 238 108 216 98 198 87 183 76 169 69 153 75 139 65 126 58 108 64 94 54 80 61 66 78 55 89 39Z"/><g clip-path="url(#indiaClip)"><polygon class="map-region active" tabindex="0" data-region="north" points="40,0 220,0 250,105 214,145 165,126 100,142 45,98"/><polygon class="map-region" tabindex="0" data-region="west" points="40,72 133,100 166,147 142,205 113,245 60,190"/><polygon class="map-region" tabindex="0" data-region="central" points="126,105 230,104 225,179 194,212 142,190 132,150"/><polygon class="map-region" tabindex="0" data-region="east" points="216,108 284,105 268,158 227,190 198,167"/><polygon class="map-region" tabindex="0" data-region="northeast" points="244,70 335,68 337,134 271,136 250,112"/><polygon class="map-region" tabindex="0" data-region="south" points="132,181 220,173 218,225 183,308 151,348 121,272"/><polygon class="map-region" tabindex="0" data-region="islands" points="273,176 302,176 302,202 273,202"/></g><path d="M74 92 224 118M93 177 200 151M121 212 210 190M146 262 200 232" fill="none" stroke="#f4efe4" stroke-width="1.4" pointer-events="none"/><text x="137" y="81" class="map-label">NORTH</text><text x="82" y="153" class="map-label">WEST</text><text x="153" y="151" class="map-label">CENTRAL</text><text x="220" y="141" class="map-label">EAST</text><text x="265" y="94" class="map-label">N.E.</text><text x="152" y="238" class="map-label">SOUTH</text><text x="296" y="190" class="map-label">ISLANDS</text>`;
const regionalNotes={north:['North India',['Kathak carries storytelling through rhythmic footwork and gesture.','Kashmiri papier-mâché and carpet traditions use intricate floral patterning.','Hindustani music includes vocal lineages such as dhrupad and khayal.','The region spans Himalayan, Punjabi, Rajasthani and Gangetic cultures.']],west:['West India',['Gujarat’s Patola is a double-ikat silk weaving tradition.','Rajasthan’s Phad painting tells stories on long painted cloth scrolls.','Maharashtra is home to Warli painting and the rock-cut Ajanta caves.','Kutch embroidery draws on distinct community designs and stitches.']],central:['Central India',['Gond artists create vibrant, line-filled images rooted in community worlds.','Bhimbetka shelters preserve prehistoric rock paintings.','Baiga and other Adivasi communities hold diverse song, dance and craft traditions.','The region connects forest, river and agrarian cultural landscapes.']],east:['East India',['Odisha’s Pattachitra painters work with cloth, natural pigments and fine outlines.','Chhau dance traditions include Purulia, Seraikella and Mayurbhanj styles.','Bengal’s Baul singers carry spiritual poetry through travelling performance.','Odissi is one of India’s classical dance forms, shaped by a long performance history.']],northeast:['North East India',['Eight states hold hundreds of languages and distinct cultural lineages.','Assam’s Sattriya developed in Vaishnava monasteries called satras.','Muga silk, associated with Assam, is known for its naturally golden sheen.','Many communities sustain rich weaving, mask-making, music and dance practices.']],south:['South India',['Koodiyattam in Kerala is a Sanskrit theatre tradition with a long performance history.','Karnataka’s Mysore painting is known for fine linework and gesso relief.','Tamil Nadu’s bronze casting includes celebrated Chola-era images.','Carnatic music and forms such as Bharatanatyam have many evolving lineages.']],islands:['Island regions',['The Andaman and Nicobar Islands are home to Indigenous peoples with distinct histories.','Lakshadweep’s culture reflects island life and long Indian Ocean connections.','Coastal ecologies shape building, foodways, song and material practices.','Island cultures are diverse; their knowledge and privacy deserve respect.']]};function setRegion(shape){document.querySelectorAll('.map-region').forEach(s=>s.classList.remove('active'));shape.classList.add('active');const [name,facts]=regionalNotes[shape.dataset.region];document.querySelector('#region-title').textContent=name;document.querySelector('#region-copy').textContent='A few cultural entry points—each region contains many more communities, histories and creative practices.';let list=document.querySelector('#region-facts');if(!list){list=document.createElement('ul');list.id='region-facts';list.className='map-facts';document.querySelector('.map-readout').append(list)}list.innerHTML=facts.map(x=>'<li>'+x+'</li>').join('')}document.querySelectorAll('.map-region').forEach(s=>{s.addEventListener('click',()=>setRegion(s));s.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();setRegion(s)}})});document.querySelectorAll('.map-label').forEach(t=>{t.setAttribute('fill','#4b453b');t.setAttribute('font-size','8');t.setAttribute('font-family','DM Sans, sans-serif');t.setAttribute('font-weight','700');t.setAttribute('text-anchor','middle');t.setAttribute('pointer-events','none')});
