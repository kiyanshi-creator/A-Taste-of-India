const polish=document.createElement('style');polish.textContent=`.journey-steps{display:flex;gap:11px;align-items:center;margin-top:20px;color:#ded4bf;font-size:.66rem;letter-spacing:.17em;font-weight:700}.journey-steps span{color:#cba866}.today-bridge{display:flex;justify-content:center;align-items:center;gap:clamp(8px,2vw,22px);padding:12px 16px;margin:0 0 22px;border-top:1px solid #ded8ca;border-bottom:1px solid #ded8ca;color:#68665f;font-size:.65rem;letter-spacing:.13em;font-weight:700}.today-bridge i{font-style:normal;color:#b08b4f}.future{background-image:radial-gradient(ellipse at 82% 12%,rgba(70,110,236,.18),transparent 37%),linear-gradient(135deg,rgba(255,255,255,.018) 25%,transparent 25%,transparent 50%,rgba(255,255,255,.018) 50%,rgba(255,255,255,.018) 75%,transparent 75%);background-size:auto,34px 34px}.future-card{transition:transform .28s ease,border-color .28s ease,background .28s ease}.future-card:hover{transform:translateY(-3px);border-color:#687bb7;background:rgba(29,44,81,.75)}.future-contribution{max-width:720px;margin:24px auto 0;color:#6d665a;font:italic 1.1rem/1.65 var(--serif)}.closing{padding-top:110px;padding-bottom:110px}.map-regions button{transition:background .2s,color .2s,border-color .2s}.quiz-options button:focus-visible,.map-regions button:focus-visible{outline:3px solid #c39450;outline-offset:3px}@media(max-width:650px){.journey-steps{gap:6px;letter-spacing:.09em;font-size:.57rem;flex-wrap:wrap}.today-bridge{flex-wrap:wrap;line-height:1.5;gap:7px 10px;text-align:center}.closing{padding-top:78px;padding-bottom:78px}}@media(prefers-reduced-motion:reduce){.future-card{transition:none!important}.future-card:hover{transform:none}}`;document.head.append(polish);
// Read every slider from the live DOM so each change produces a fresh, personal future statement.
const liveScenarioIds=['heritage','access','sustain','tech','community'];const liveScenarioInputs=liveScenarioIds.map(id=>document.getElementById(id)).filter(Boolean).map(input=>{const clone=input.cloneNode(true);input.replaceWith(clone);return clone});function renderPersonalFuture(){const values=Object.fromEntries(liveScenarioIds.map(id=>[id,+document.getElementById(id).value]));const describe=n=>n>=70?'a strong priority':n>=40?'a growing commitment':'a challenge still to address';const lead=values.community>=70?'A community-led future':values.tech>=70?'A digitally connected future':values.sustain>=70?'A more sustainable creative future':values.access>=70?'A more accessible cultural future':'A future still taking shape';const paragraph=`In your vision, living heritage is ${describe(values.heritage)}, cultural access is ${describe(values.access)}, sustainable making is ${describe(values.sustain)}, creative technology is ${describe(values.tech)}, and community leadership is ${describe(values.community)}. These choices are yours to shape.`;document.querySelector('#scenario-title').textContent=lead;document.querySelector('#scenario-copy').textContent=paragraph;document.querySelector('#future-contribution').textContent=`Your 2047 contribution: ${lead.toLowerCase()} — shaped by the values you chose above.`}liveScenarioInputs.forEach(input=>input.addEventListener('input',renderPersonalFuture));renderPersonalFuture();
